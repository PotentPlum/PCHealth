<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <StartupObject>PCHealth.App.Program</StartupObject>
    <!-- Drawn by tools/icon/make_icon.py; also used by the installers (release.yml). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>PC Health Monitor</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PCHealth.Benchmarking/PCHealth.Benchmarking.csproj" />
    <ProjectReference Include="../PCHealth.Execution.Windows/PCHealth.Execution.Windows.csproj" />
    <ProjectReference Include="../PCHealth.Inventory.Windows/PCHealth.Inventory.Windows.csproj" />
    <ProjectReference Include="../PCHealth.Organization/PCHealth.Organization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Velopack" />
  </ItemGroup>

</Project>
