<Window x:Class="PCHealth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCHealth.App.ViewModels"
        Title="PC Health Monitor" Width="960" Height="640" MinWidth="640" MinHeight="420">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <TextBlock Margin="24" FontSize="20" Text="{Binding Title}" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <TextBlock Margin="24" FontSize="20" Text="{Binding Title}" />
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="14,6"
                        Content="{Binding Pause.Label}"
                        Command="{Binding Pause.ToggleCommand}"
                        AutomationProperties.HelpText="{Binding Pause.Status}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" Text="{Binding Pause.Status}" />
            </DockPanel>
        </Border>
        <ListBox DockPanel.Dock="Left" Width="180" BorderThickness="0"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding Current, Mode=TwoWay}"
                 DisplayMemberPath="Title" />
        <ContentControl Content="{Binding Current}" />
    </DockPanel>
</Window>
