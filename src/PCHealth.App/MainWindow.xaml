<Window x:Class="PCHealth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCHealth.App.ViewModels"
        Title="PC Health Monitor" Icon="Assets/app.ico" Width="960" Height="640" MinWidth="640" MinHeight="420">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate DataType="{x:Type vm:DiscoveryProgressViewModel}">
            <Border Margin="0,0,0,12" Padding="12" BorderThickness="1" CornerRadius="6"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Visibility="{Binding IsActive, Converter={StaticResource Visible}}">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Steps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ProgressBar Height="10" Margin="0,8,0,4" Minimum="0" Maximum="100"
                                 Value="{Binding Percent, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" />
                    <TextBlock TextWrapping="Wrap" Text="{Binding Estimate}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Counts}" />
                    <TextBlock TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Opacity="0.75" FontSize="12" Text="{Binding CurrentFolder}" />
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FirstRunViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Welcome to PC Health Monitor" Margin="0,0,0,16" />
                    <TextBlock FontWeight="SemiBold" Text="What is inspected" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding WhatWeInspect}" />
                    <TextBlock FontWeight="SemiBold" Text="What is stored" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding WhatWeStore}" />
                    <TextBlock FontWeight="SemiBold" Text="Network" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Text="{Binding Network}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Padding="14,6" Content="Look for wasted space" Command="{Binding StartCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Stop" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{Binding Status}" />
                    <ContentControl Content="{Binding Progress}" />
                    <Border Margin="0,16,0,0" Padding="16" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            DataContext="{Binding FirstFinding}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WhatWeFound}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding WhyItMatters}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Impact.PotentiallyReclaimable}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding CanIRecover}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Overview" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Summary}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button Padding="14,6" FontWeight="SemiBold" Content="{Binding CleanUpAllText}" Command="{Binding CleanUpAllCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="{Binding ShowAllText}" Command="{Binding ShowAllCommand}"
                                Visibility="{Binding CanShowAll, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Opacity="0.85" Text="{Binding NeedChoiceText}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecommendationItemViewModel}">
                                <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" CornerRadius="6"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WhatWeFound}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding WhyItMatters}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85" Text="{Binding Evidence}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding WhatWillChange}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding WhatCouldHappenAfterward}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding CanIRecover}" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding Confidence}" />
                                        <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Recovery}" />
                                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{Binding ReviewReason}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Padding="12,4" FontWeight="SemiBold" Content="Clean up…"
                                                    ToolTip="Shows exactly what would change before anything is done."
                                                    Visibility="{Binding IsAction, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Padding="12,4" Margin="8,0,0,0" Content="Details" Command="{Binding ToggleDetailsCommand}" />
                                        </StackPanel>
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Details}"
                                                      Visibility="{Binding ShowDetails, Converter={StaticResource Visible}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Storage" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Status}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Padding="14,6" Content="Measure again" Command="{Binding MeasureCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Stop" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <ContentControl Content="{Binding Progress}" />
                    <StackPanel Visibility="{Binding HasMeasurement, Converter={StaticResource Visible}}">
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Left" Padding="10,4" Margin="0,0,8,0" Content="Up" Command="{Binding UpCommand}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Location}" />
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Total}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding FilesHere}" />
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{Binding Reclaimable}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,12" Text="{Binding Completeness}" />
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StorageFolderViewModel}">
                                    <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,6"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Size, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Files, Mode=OneWay}" />
                                            </TextBlock>
                                            <ProgressBar Height="6" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                                         AutomationProperties.Name="{Binding ShareText}" />
                                            <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{Binding Reclaimable}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontWeight="SemiBold" Margin="0,12,0,4" Text="By file type (whole user folder)" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Preview" />
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding WhatWeFound}" />
                    <TextBlock FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding CloseFirst}"
                               Visibility="{Binding HasCloseFirst, Converter={StaticResource Visible}}" />
                    <TextBlock FontWeight="SemiBold" Text="Exactly what would change (untick to leave an item out)" />
                    <ItemsControl Margin="0,4,0,12" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PreviewItemViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Path, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Size, Mode=OneWay}" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontWeight="SemiBold" Text="Left alone" />
                    <ItemsControl Margin="0,4,0,12" ItemsSource="{Binding LeftAlone}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontWeight="SemiBold" Text="Expected effect" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding ExpectedEffect}" />
                    <TextBlock FontWeight="SemiBold" Text="Afterwards" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding Afterward}" />
                    <TextBlock FontWeight="SemiBold" Text="Recovery and retention" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Text="{Binding RecoveryTerms}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6" Content="Approve" Command="{Binding ApproveCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Decline" Command="{Binding DeclineCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Back" Command="{Binding BackCommand}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding Result}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BatchPreviewViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Clean up all suggested" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12"
                               Text="Every suggested action, exactly as it would run. Untick an action to leave it out; open one to see each item. Nothing changes until you approve." />
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BatchPreviewEntryViewModel}">
                                <Border Margin="0,0,0,10" Padding="12" BorderThickness="1" CornerRadius="6"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <StackPanel>
                                        <CheckBox IsChecked="{Binding IsSelected}">
                                            <TextBlock TextWrapping="Wrap" FontWeight="SemiBold" Text="{Binding WhatWeFound}" />
                                        </CheckBox>
                                        <Expander Margin="0,6,0,0" Header="{Binding Summary}">
                                            <StackPanel Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Paths}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding LeftAlone}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Afterward}" />
                                            </StackPanel>
                                        </Expander>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="Bold" Text="{Binding CloseFirst}"
                                                   Visibility="{Binding HasCloseFirst, Converter={StaticResource Visible}}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding RecoveryTerms}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" FontWeight="SemiBold" Text="{Binding Result}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontWeight="SemiBold" Margin="0,4,0,0" Text="Expected effect" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Text="{Binding ExpectedEffect}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6" FontWeight="SemiBold" Content="Approve all selected" Command="{Binding ApproveCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Back" Command="{Binding BackCommand}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding Result}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BenchmarkViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Benchmark" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding Explanation}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Padding="14,6" FontWeight="SemiBold" Content="Run benchmark" Command="{Binding RunCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Stop" Command="{Binding StopCommand}" />
                    </StackPanel>
                    <ProgressBar Height="10" Margin="0,0,0,8" IsIndeterminate="True"
                                 Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding Status}" />
                    <TextBlock FontWeight="SemiBold" Text="Where reports are saved" />
                    <TextBox Margin="0,4,0,4" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Text="{Binding ReportPath, TargetNullValue='', Mode=OneWay}" />
                    <TextBox Margin="0,0,0,8" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Text="{Binding ReportsFolder, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Padding="12,4" Content="Open folder" Command="{Binding OpenFolderCommand}" />
                        <Button Padding="12,4" Margin="8,0,0,0" Content="Copy path" Command="{Binding CopyPathCommand}" />
                    </StackPanel>
                    <TextBox IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                             Text="{Binding Report, Mode=OneWay}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}">
            <DockPanel Margin="24,24,24,0">
                <TextBlock DockPanel.Dock="Top" FontSize="24" Margin="0,0,0,8" Text="Duplicates" />
                <TabControl>
                    <TabItem Header="Identical copies">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Text="{Binding Summary}" />
                                <ItemsControl ItemsSource="{Binding Groups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
                                            <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" CornerRadius="6"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                                <StackPanel>
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Summary}" />
                                                    <ItemsControl ItemsSource="{Binding Copies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:DuplicateCopyViewModel}">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0" IsChecked="{Binding IsSelected}"
                                                                              ToolTip="Remove this copy" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text="{Binding Path}" />
                                                                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{Binding HardLinks}" />
                                                                        <TextBlock TextWrapping="Wrap" Foreground="DarkRed" Text="{Binding Blocked}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="180">
                                                                        <TextBlock Text="{Binding Size}" />
                                                                        <TextBlock Text="{Binding Modified}" />
                                                                        <TextBlock Text="{Binding Created}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Padding="12,4" FontWeight="SemiBold" Content="{Binding RemoveText}"
                                                                ToolTip="Shows exactly what would change before anything is done."
                                                                Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Padding="12,4" Margin="8,0,0,0" Content="Evidence" Command="{Binding ToggleEvidenceCommand}" />
                                                    </StackPanel>
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="DarkRed" Text="{Binding Message}" />
                                                    <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Evidence}"
                                                                  Visibility="{Binding ShowEvidence, Converter={StaticResource Visible}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,0,0,2" Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{Binding VersionsTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="12" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock TextWrapping="Wrap" FontStyle="Italic" Margin="0,0,0,8" Text="{Binding VersionsExplanation}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Text="{Binding VersionsSummary}" />
                                <ItemsControl ItemsSource="{Binding Versions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:VersionGroupViewModel}">
                                            <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" CornerRadius="6"
                                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                                <StackPanel>
                                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Title}" />
                                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Opacity="0.85" Text="{Binding Confidence}" />
                                                    <ItemsControl ItemsSource="{Binding Files}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:VersionFileViewModel}">
                                                                <Grid Margin="0,0,0,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Grid.Column="0" VerticalAlignment="Top" Margin="0,2,8,0" IsChecked="{Binding IsSelected}"
                                                                              ToolTip="Remove this file" />
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text="{Binding Path}" />
                                                                        <TextBlock TextWrapping="Wrap" Foreground="DarkRed" Text="{Binding Blocked}" />
                                                                    </StackPanel>
                                                                    <StackPanel Grid.Column="2" Margin="12,0,0,0" MinWidth="200">
                                                                        <TextBlock Text="{Binding Size}" />
                                                                        <TextBlock Text="{Binding Modified}" />
                                                                        <TextBlock Text="{Binding Created}" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Button HorizontalAlignment="Left" Padding="12,4" Margin="0,4,0,0" Content="{Binding RemoveText}"
                                                            ToolTip="Shows exactly what would change before anything is done."
                                                            Command="{Binding DataContext.RemoveVersionsCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Foreground="DarkRed" Text="{Binding Message}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </DockPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Activity" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Empty}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold" Text="{Binding Message}" />
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityEntryViewModel}">
                                <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" CornerRadius="6"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding WhatChanged, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding When, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Why}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Outcome}" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Deadline}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding UndoTerms}" />
                                        <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" Content="Undo"
                                                Visibility="{Binding CanUndo, Converter={StaticResource Visible}}"
                                                Command="{Binding UndoCommand}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Settings" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" FontWeight="SemiBold" Text="{Binding Message}" />
                    <TextBlock FontSize="18" Text="Quarantine period" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" Text="{Binding RetentionHelp}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox Width="60" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Quarantine period in days" />
                        <TextBlock VerticalAlignment="Center" Margin="6,0,12,0" Text="days" />
                        <Button Padding="12,4" Content="Save" Command="{Binding SaveRetentionCommand}" />
                    </StackPanel>
                    <TextBlock FontSize="18" Text="Exclusions" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" Text="Excluded items are never suggested or changed." />
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ExclusionItemViewModel}">
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Padding="10,2" Content="Remove" Command="{Binding RemoveCommand}" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Text}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,16">
                        <Button DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Content="Exclude" Command="{Binding AddExclusionCommand}" />
                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Full path to exclude" />
                    </DockPanel>
                    <TextBlock FontSize="18" Text="What this app keeps on this PC" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,4" Text="{Binding DataFolder}" />
                    <ItemsControl ItemsSource="{Binding StoredData}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Margin="0,8,0,16" Padding="12,4" Content="Open folder" Command="{Binding OpenFolderCommand}" />
                    <TextBlock FontSize="18" Text="Clear local data" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" Text="{Binding ClearTerms}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontStyle="Italic" Text="{Binding ClearBlockedBy}" />
                    <CheckBox Margin="0,0,0,6" Content="I understand what clearing removes" IsChecked="{Binding ClearConfirmed}" />
                    <Button HorizontalAlignment="Left" Padding="12,4" Content="Clear local data" Command="{Binding ClearCommand}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock FontSize="24" Text="Updates" />
                <TextBlock Margin="0,4,0,12" Text="{Binding Version}" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding Source={x:Static vm:UpdatesViewModel.Disclosure}}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Padding="14,6" Content="Check for updates" Command="{Binding CheckCommand}" />
                    <Button Padding="14,6" Margin="8,0,0,0" Content="Install and restart" Command="{Binding InstallCommand}" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="14,6"
                        Content="{Binding Pause.Label}"
                        Command="{Binding Pause.ToggleCommand}"
                        AutomationProperties.HelpText="{Binding Pause.Status}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" Text="{Binding Pause.Status}" />
            </DockPanel>
        </Border>
        <ListBox DockPanel.Dock="Left" Width="180" BorderThickness="0"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding Current, Mode=TwoWay}"
                 DisplayMemberPath="Title" />
        <ContentControl Content="{Binding Current}" />
    </DockPanel>
</Window>
