<Window x:Class="PCHealth.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PCHealth.App.ViewModels"
        Title="PC Health Monitor" Icon="Assets/app.ico" Width="960" Height="640" MinWidth="640" MinHeight="420">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:FirstRunViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Welcome to PC Health Monitor" Margin="0,0,0,16" />
                    <TextBlock FontWeight="SemiBold" Text="What is inspected" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding WhatWeInspect}" />
                    <TextBlock FontWeight="SemiBold" Text="What is stored" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding WhatWeStore}" />
                    <TextBlock FontWeight="SemiBold" Text="Network" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Text="{Binding Network}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Padding="14,6" Content="Look for wasted space" Command="{Binding StartCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Stop" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
                    <Border Margin="0,16,0,0" Padding="16" BorderThickness="1" CornerRadius="6"
                            BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                            DataContext="{Binding FirstFinding}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WhatWeFound}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding WhyItMatters}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Impact.PotentiallyReclaimable}" />
                            <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding CanIRecover}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate DataType="{x:Type vm:OverviewViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Overview" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Text="{Binding Summary}" />
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecommendationItemViewModel}">
                                <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" CornerRadius="6"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding WhatWeFound}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding WhyItMatters}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85" Text="{Binding Evidence}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding WhatWillChange}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding WhatCouldHappenAfterward}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding CanIRecover}" />
                                        <TextBlock Margin="0,8,0,0" Text="{Binding Confidence}" />
                                        <TextBlock Text="{Binding Impact}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Recovery}" />
                                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{Binding ReviewReason}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Padding="12,4" Content="Details" Command="{Binding ToggleDetailsCommand}" />
                                            <Button Padding="12,4" Margin="8,0,0,0" Content="Preview…"
                                                    Visibility="{Binding IsAction, Converter={StaticResource Visible}}"
                                                    Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Details}"
                                                      Visibility="{Binding ShowDetails, Converter={StaticResource Visible}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Storage" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Status}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Padding="14,6" Content="Measure again" Command="{Binding MeasureCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Stop" Command="{Binding CancelCommand}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding HasMeasurement, Converter={StaticResource Visible}}">
                        <DockPanel Margin="0,0,0,4">
                            <Button DockPanel.Dock="Left" Padding="10,4" Margin="0,0,8,0" Content="Up" Command="{Binding UpCommand}" />
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Location}" />
                        </DockPanel>
                        <TextBlock TextWrapping="Wrap" Text="{Binding Total}" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding FilesHere}" />
                        <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{Binding Reclaimable}" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.85" Margin="0,4,0,12" Text="{Binding Completeness}" />
                        <ItemsControl ItemsSource="{Binding Folders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:StorageFolderViewModel}">
                                    <Button HorizontalContentAlignment="Stretch" Margin="0,0,0,6" Padding="12,6"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold" TextWrapping="Wrap">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Size, Mode=OneWay}" />
                                                <Run Text=" · " />
                                                <Run Text="{Binding Files, Mode=OneWay}" />
                                            </TextBlock>
                                            <ProgressBar Height="6" Margin="0,4,0,0" Minimum="0" Maximum="1" Value="{Binding Share, Mode=OneWay}"
                                                         AutomationProperties.Name="{Binding ShareText}" />
                                            <TextBlock TextWrapping="Wrap" FontStyle="Italic" Text="{Binding Reclaimable}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontWeight="SemiBold" Margin="0,12,0,4" Text="By file type (whole user folder)" />
                        <ItemsControl ItemsSource="{Binding Categories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PreviewViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Preview" />
                    <TextBlock FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding WhatWeFound}" />
                    <TextBlock FontWeight="SemiBold" Text="Exactly what would change (untick to leave an item out)" />
                    <ItemsControl Margin="0,4,0,12" ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PreviewItemViewModel}">
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,2">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{Binding Path, Mode=OneWay}" />
                                        <Run Text=" · " />
                                        <Run Text="{Binding Size, Mode=OneWay}" />
                                    </TextBlock>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontWeight="SemiBold" Text="Left alone" />
                    <ItemsControl Margin="0,4,0,12" ItemsSource="{Binding LeftAlone}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock FontWeight="SemiBold" Text="Expected effect" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding ExpectedEffect}" />
                    <TextBlock FontWeight="SemiBold" Text="Afterwards" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" Text="{Binding Afterward}" />
                    <TextBlock FontWeight="SemiBold" Text="Recovery and retention" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,16" Text="{Binding RecoveryTerms}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Padding="14,6" Content="Approve" Command="{Binding ApproveCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Decline" Command="{Binding DeclineCommand}" />
                        <Button Padding="14,6" Margin="8,0,0,0" Content="Back" Command="{Binding BackCommand}" />
                    </StackPanel>
                    <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" Text="{Binding Result}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ActivityViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Activity" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,8" Text="{Binding Empty}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" FontWeight="SemiBold" Text="{Binding Message}" />
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ActivityEntryViewModel}">
                                <Border Margin="0,0,0,12" Padding="16" BorderThickness="1" CornerRadius="6"
                                        BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
                                    <StackPanel>
                                        <TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap">
                                            <Run Text="{Binding WhatChanged, Mode=OneWay}" />
                                            <Run Text=" · " />
                                            <Run Text="{Binding When, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Why}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding Outcome}" />
                                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock TextWrapping="Wrap" FontSize="12" Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock TextWrapping="Wrap" Margin="0,6,0,0" Text="{Binding Deadline}" />
                                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{Binding UndoTerms}" />
                                        <Button HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,4" Content="Undo"
                                                Visibility="{Binding CanUndo, Converter={StaticResource Visible}}"
                                                Command="{Binding UndoCommand}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="24" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock FontSize="24" Text="Settings" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,12" FontWeight="SemiBold" Text="{Binding Message}" />
                    <TextBlock FontSize="18" Text="Quarantine period" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" Text="{Binding RetentionHelp}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <TextBox Width="60" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Quarantine period in days" />
                        <TextBlock VerticalAlignment="Center" Margin="6,0,12,0" Text="days" />
                        <Button Padding="12,4" Content="Save" Command="{Binding SaveRetentionCommand}" />
                    </StackPanel>
                    <TextBlock FontSize="18" Text="Exclusions" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" Text="Excluded items are never suggested or changed." />
                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ExclusionItemViewModel}">
                                <DockPanel Margin="0,2">
                                    <Button DockPanel.Dock="Right" Padding="10,2" Content="Remove" Command="{Binding RemoveCommand}" />
                                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding Text}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <DockPanel Margin="0,6,0,16">
                        <Button DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Content="Exclude" Command="{Binding AddExclusionCommand}" />
                        <TextBox Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Full path to exclude" />
                    </DockPanel>
                    <TextBlock FontSize="18" Text="What this app keeps on this PC" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,4" Text="{Binding DataFolder}" />
                    <ItemsControl ItemsSource="{Binding StoredData}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Text="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Margin="0,8,0,16" Padding="12,4" Content="Open folder" Command="{Binding OpenFolderCommand}" />
                    <TextBlock FontSize="18" Text="Clear local data" />
                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,6" Text="{Binding ClearTerms}" />
                    <TextBlock TextWrapping="Wrap" Margin="0,0,0,6" FontStyle="Italic" Text="{Binding ClearBlockedBy}" />
                    <CheckBox Margin="0,0,0,6" Content="I understand what clearing removes" IsChecked="{Binding ClearConfirmed}" />
                    <Button HorizontalAlignment="Left" Padding="12,4" Content="Clear local data" Command="{Binding ClearCommand}" />
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <StackPanel Margin="24" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock FontSize="24" Text="Updates" />
                <TextBlock Margin="0,4,0,12" Text="{Binding Version}" />
                <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding Source={x:Static vm:UpdatesViewModel.Disclosure}}" />
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Padding="14,6" Content="Check for updates" Command="{Binding CheckCommand}" />
                    <Button Padding="14,6" Margin="8,0,0,0" Content="Install and restart" Command="{Binding InstallCommand}" />
                </StackPanel>
                <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="16,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Padding="14,6"
                        Content="{Binding Pause.Label}"
                        Command="{Binding Pause.ToggleCommand}"
                        AutomationProperties.HelpText="{Binding Pause.Status}" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0" Text="{Binding Pause.Status}" />
            </DockPanel>
        </Border>
        <ListBox DockPanel.Dock="Left" Width="180" BorderThickness="0"
                 ItemsSource="{Binding Pages}"
                 SelectedItem="{Binding Current, Mode=TwoWay}"
                 DisplayMemberPath="Title" />
        <ContentControl Content="{Binding Current}" />
    </DockPanel>
</Window>
